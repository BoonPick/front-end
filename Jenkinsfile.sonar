pipeline {
    agent any

    parameters {
        string(
            name: 'BRANCH',
            defaultValue: 'sonar-frontend',
            description: '분석할 프론트 GitHub 브랜치명'
        )
    }

    environment {
        SONAR_HOST_URL = 'http://163.239.77.71:9000'
        SONAR_TOKEN    = credentials('sonar-token')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    url: 'https://github.com/BoonPick/front-end.git'
                echo "분석 브랜치: ${params.BRANCH}"
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install
                '''
            }
        }

        stage('Build Check') {
            steps {
                sh '''
                    npm run build
                '''
            }
        }

        stage('Lint Check') {
            steps {
                sh '''
                    npm run lint
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar'
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            "'"${scannerHome}"'/bin/sonar-scanner" \
                              -Dsonar.projectKey=boonpick-frontend \
                              -Dsonar.projectName="BoonPick Frontend" \
                              -Dsonar.sources=src \
                              -Dsonar.exclusions=node_modules/**,dist/**,coverage/**,public/**,docs/**,.claude/** \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            echo "Frontend SonarQube 분석 완료 - GitHub 브랜치: ${params.BRANCH}"
        }
    }
}